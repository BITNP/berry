# 服务监听与对外源
BERRY_HOST=127.0.0.1
BERRY_PORT=3220
BERRY_PUBLIC_URL=http://127.0.0.1:3220
BERRY_DATA_DIR=./data

# 入站 OneBot 11 HTTP Webhook 校验令牌（支持 Authorization: Bearer 或 X-Signature）
BERRY_WEBHOOK_TOKEN=replace-with-webhook-secret

# 出站 BITNP/message-gateway
BERRY_GATEWAY_URL=http://127.0.0.1:8081
BERRY_GATEWAY_ACCOUNT=qq
BERRY_GATEWAY_TOKEN=replace-with-gateway-client-token

# 机器人基础信息与模型初始种子（首次启动写入 SQLite，后续可在管理台热修改）
BERRY_BOT_QQ=
BERRY_MAIN_BASE_URL=https://api.openai.com/v1
BERRY_MAIN_API_KEY=
BERRY_MAIN_MODEL=gpt-4.1-mini
BERRY_GATE_BASE_URL=https://api.openai.com/v1
BERRY_GATE_API_KEY=
BERRY_GATE_MODEL=gpt-4.1-nano

# 管理台 Keycloak OIDC 登录
BERRY_OIDC_ISSUER=https://login.example.com/realms/master
BERRY_OIDC_CLIENT_ID=berry
BERRY_OIDC_CLIENT_SECRET=replace-with-oidc-secret

# 仅限本地开发免登录调试，生产环境务必保持 false
BERRY_DEV_AUTH_BYPASS=false
BERRY_DEV_AUTH_SUBJECT=dev-admin
BERRY_DEV_AUTH_NAME="Dev Admin"

# Keycloak Admin API（用于 QQ <-> subject 双向身份解析）
BERRY_KEYCLOAK_ADMIN_URL=https://login.example.com/admin/realms/master
BERRY_KEYCLOAK_CLIENT_ID=berry-admin
BERRY_KEYCLOAK_CLIENT_SECRET=replace-with-kc-admin-secret
BERRY_KEYCLOAK_QQ_ATTR=qq_number

# Guild 内部服务接口（用于节点协作、实时事件流、到期提醒及自然周周报）
BERRY_GUILD_API_URL=http://127.0.0.1:8080
BERRY_GUILD_INTERNAL_TOKEN=replace-with-guild-internal-token
BERRY_GUILD_PUBLIC_URL=https://guild.example.com
