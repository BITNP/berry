{
  "name": "berry",
  "private": true,
  "version": "0.2.2",
  "packageManager": "pnpm@12.9.0",
  "type": "module",
  "engines": {
    "node": "^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "build": "vue-tsc -p tsconfig.web.json --noEmit && vite build",
    "check": "pnpm typecheck && pnpm lint",
    "dev": "node --watch src/main.ts",
    "dev:web": "vite",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "start": "node src/main.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && vue-tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@lucide/vue": "^1.28.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "bitnp-authz": "file:./third_party/bitnp-authz",
    "croner": "^11.0.1",
    "date-fns": "^4.4.0",
    "eventsource-parser": "^4.1.3",
    "file-type": "^22.3.0",
    "h3": "^1.15.11",
    "image-size": "^2.1.0",
    "jsonrepair": "^3.15.0",
    "kysely": "^0.29.6",
    "lru-cache": "^11.5.3",
    "mrmime": "^2.0.1",
    "naive-ui": "^2.45.3",
    "ofetch": "^1.5.1",
    "openai": "^7.32.0",
    "openid-client": "^6.9.0",
    "partysocket": "^1.3.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "quickjs-emscripten": "^0.32.0",
    "typebox": "^1.3.27",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@so1ve/eslint-config": "^4.7.0",
    "@so1ve/prettier-config": "^4.7.0",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vue-tsc": "^3.2.4"
  }
}
